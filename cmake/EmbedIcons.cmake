# Generates a header with embedded ARGB pixmaps for the StatusNotifierItem.
string(REPLACE "," ";" ICONS "${ICONS}")
foreach(icon IN LISTS ICONS)
    get_filename_component(icon_name "${icon}" NAME_WE)
    string(REPLACE "-" "_" icon_name "${icon_name}")
    get_filename_component(icon_path "${icon}" ABSOLUTE)
    file(READ "${icon_path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND declarations "inline constexpr unsigned char ${icon_name}_data[] = {${bytes}};\n")
endforeach()

file(WRITE "${OUTPUT}" "// Generated by cmake/EmbedIcons.cmake. Do not edit.\n#pragma once\n\nnamespace pipeduck::icons {\n\nstruct EmbeddedPixmap {\n    int width;\n    int height;\n    const unsigned char* data;\n};\n\n${declarations}\ninline constexpr EmbeddedPixmap tray_pixmaps[] = {\n")
file(APPEND "${OUTPUT}" "    {16, 16, pipeduck_16_data},\n    {22, 22, pipeduck_22_data},\n    {24, 24, pipeduck_24_data},\n    {32, 32, pipeduck_32_data},\n    {48, 48, pipeduck_48_data},\n    {64, 64, pipeduck_64_data},\n};\n\ninline constexpr EmbeddedPixmap tray_pixmaps_on[] = {\n")
file(APPEND "${OUTPUT}" "    {16, 16, pipeduck_on_16_data},\n    {22, 22, pipeduck_on_22_data},\n    {24, 24, pipeduck_on_24_data},\n    {32, 32, pipeduck_on_32_data},\n    {48, 48, pipeduck_on_48_data},\n    {64, 64, pipeduck_on_64_data},\n};\n\n}  // namespace pipeduck::icons\n")
