# Maintainer: ErRusso <172048352+ErRusso@users.noreply.github.com>

pkgname=pipeduck
pkgver=1.1.0
pkgrel=1
pkgdesc='Automatic audio ducking for PipeWire, controlled from the system tray'
arch=('x86_64' 'aarch64')
url='https://github.com/ErRusso/pipeduck'
license=('MIT')
depends=(
  'pipewire'
  'libpulse'
  'json-c'
  'glib2'
  'gtk4'
  'ncurses'
)
makedepends=('cmake' 'pkgconf')
checkdepends=('dbus')
optdepends=(
  'pipewire-pulse: PulseAudio compatibility layer used by pactl'
  'gnome-shell-extension-appindicator: StatusNotifierItem tray support on GNOME'
)
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/ErRusso/pipeduck/archive/refs/tags/v$pkgver.tar.gz"
  'fix-installed-icon-path.patch'
)
sha256sums=(
  '6f013a205563d425e4e6af337417d8a3d4af9adea5917b7252df9763b912ef86'
  '1d71c48185b2ed10b80e32456cd23272e41209c7f9de98147e63e5c3cfd5c524'
)

prepare() {
  cd "$pkgname-$pkgver"
  patch -Np1 -i "$srcdir/fix-installed-icon-path.patch"
}

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DPIPEDUCK_BUILD_TESTS=ON \
    -DPIPEDUCK_GUI=ON \
    -DPIPEDUCK_ASSETS_DIR=/usr/share/icons
  cmake --build build --parallel
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
